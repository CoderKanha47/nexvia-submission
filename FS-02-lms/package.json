{
  "name": "lms-with-liveclass",
  "private": true,
  "version": "0.1.0",
  "description": "LMS with Live Classes - courses, HLS video, live classes, quizzes, certificates",
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace server",
    "build": "npm run build --workspace server",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed": "tsx scripts/seed.ts",
    "videos": "tsx scripts/process-sample-videos.ts",
    "worker": "npm run worker --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}

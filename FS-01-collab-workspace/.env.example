# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://workspace:workspace@localhost:5432/workspace?schema=public"

# --- Redis (pub/sub between sync instances + SSE event bus) ---
REDIS_URL="redis://localhost:6379"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# --- WebSocket auth (HS256 shared between web API and sync server) ---
WS_TOKEN_SECRET="replace-with-another-long-random-string"

# --- Sync server ---
# Dev: run the sync server directly on 1234. Docker: nginx LB exposes 4000.
SYNC_PORT=1234
NEXT_PUBLIC_SYNC_URL="ws://localhost:1234"

# --- GitHub OAuth (optional; leave empty to disable) ---
GITHUB_ID=""
GITHUB_SECRET=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
